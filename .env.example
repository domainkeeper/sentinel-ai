# ------------------------------------------------------------------
# Sentinel AI — Environment Configuration
# Copy this file to `.env` and fill in real values locally.
# NEVER commit real secrets. See .gitignore.
# ------------------------------------------------------------------

# Application
# -------------
# Environment: development | test | production
NODE_ENV=development
# Port the HTTP API listens on
PORT=3000

# Persistence
# -------------
# SQLite database file path. Use ":memory:" for tests.
# Relative paths are resolved against the project root.
DATABASE_PATH=data/sentinel.db

# Logging
# -------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Autonomous lifecycle
# ---------------------
# Base interval (seconds) between scheduler ticks.
SCHEDULER_INTERVAL_SECONDS=3600

# LLM configuration (Phase 2D - Content Generation + Rationale)
# ---------------------------------------------------------------------
# Provider: gemini | openai | mock
LLM_PROVIDER=gemini
# Model name (e.g. gemini-2.5-flash or gpt-4o-mini)
LLM_MODEL=gemini-2.5-flash
# API key for the selected provider
LLM_API_KEY=
# Request timeout in milliseconds
LLM_TIMEOUT_MS=30000

# Live topic sources (used by later phases — topic discovery)
# -------------------------------------------------------------
# RSS feeds to poll, comma-separated. Not used in the foundation phase.
DISCOVERY_RSS_FEEDS=
# Maximum milliseconds for one external topic-source HTTP request.
DISCOVERY_HTTP_TIMEOUT_MS=15000